# Copy to .env and fill in. .env is gitignored; this file is the tracked contract.

# --- Processing & AI layer ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MTA_VISION_MODEL=claude-opus-5
MTA_MAX_CONCURRENT_LLM_CALLS=4

# --- Storage layer -----------------------------------------------------------
# SQLite for local dev; swap for a postgresql+psycopg:// URL without code changes.
MTA_DATABASE_URL=sqlite:///data/warehouse/mta.db

# --- Ingestion layer ---------------------------------------------------------
# Politeness controls. Keep these conservative.
MTA_REQUESTS_PER_MINUTE=10
MTA_REQUEST_TIMEOUT_SECONDS=20
MTA_MAX_RETRIES=3
MTA_USER_AGENT=micro-trend-arbitrage-engine/0.1 (portfolio project; contact: you@example.com)

# Which ingestion adapter the pipeline uses: fixture | depop | thredup
# `fixture` replays recorded HTML from tests/fixtures and requires no network.
MTA_INGESTION_SOURCE=fixture

# --- Observability -----------------------------------------------------------
MTA_LOG_LEVEL=INFO
MTA_LOG_FORMAT=console
