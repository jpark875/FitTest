# Copy to .env and fill in. .env is gitignored; this file is the tracked contract.
# Every variable below maps to a validated field in src/mta/config.py.
# All of them have defaults: an empty .env runs the pipeline offline.

# --- Processing & AI layer ---------------------------------------------------
# Read without the MTA_ prefix: it is the name the Anthropic SDK already expects.
ANTHROPIC_API_KEY=sk-ant-...
MTA_VISION_MODEL=claude-opus-5
MTA_PROMPT_VERSION=v1
MTA_MAX_CONCURRENT_LLM_CALLS=4
MTA_LLM_TIMEOUT_SECONDS=120

# --- Storage layer -----------------------------------------------------------
# SQLite for local dev; swap for a postgresql+psycopg:// URL without code changes.
MTA_DATABASE_URL=sqlite:///data/warehouse/mta.db

# --- Ingestion layer ---------------------------------------------------------
# Which adapter the pipeline reads from: fixture | depop | thredup
# `fixture` replays recorded payloads from tests/fixtures and requires no network.
MTA_INGESTION_SOURCE=fixture

# Politeness controls. Values above 30/min are REJECTED at startup for any live
# source (see POLITE_RPM_CEILING in config.py). Keep these conservative.
MTA_REQUESTS_PER_MINUTE=10
MTA_REQUEST_TIMEOUT_SECONDS=20
MTA_MAX_RETRIES=3
MTA_MAX_PAGES_PER_RUN=5
MTA_USER_AGENT=micro-trend-arbitrage-engine/0.1 (portfolio project; contact: you@example.com)

# --- Scoring thresholds (the buy bar) ----------------------------------------
# Business policy, not code. Tune these without a deploy.
MTA_MIN_MARGIN_PCT=0.30
MTA_MIN_ABSOLUTE_MARGIN=10.00
MTA_MIN_CONFIDENCE=0.60
MTA_DEFAULT_PLATFORM_FEE_RATE=0.10
MTA_DEFAULT_SHIPPING_COST=4.50

# --- Observability -----------------------------------------------------------
MTA_LOG_LEVEL=INFO
MTA_LOG_FORMAT=console
